#!/bin/bash
#SBATCH --job-name=EosOP3LowDensity-beam-run
#SBATCH --output=/global/u2/m/mpatel26/alpha_analysis-mp/campaigns/EosOP3LowDensity-beam/logs/run_%A_%a.out
#SBATCH --account=m4477
#SBATCH --constraint=gpu
#SBATCH --qos=regular
#SBATCH --nodes=2
#SBATCH --ntasks-per-node=4
#SBATCH --gpus-per-node=4
#SBATCH --cpus-per-task=1
#SBATCH --time=48:00:00
#SBATCH --mail-type=begin,end,fail
#SBATCH --mail-user=mpatel26@thea.energy
# Generated by campaign.py from campaigns/EosOP3LowDensity-beam.json -- edit the manifest, not this file.

CASES="/global/u2/m/mpatel26/alpha_analysis-mp/campaigns/EosOP3LowDensity-beam/cases.tsv"
IFS=$'\t' read -r SIM H5 PARAMS MARKER < <(sed -n "${SLURM_ARRAY_TASK_ID}p" "$CASES")
if [ -z "$SIM" ]; then echo "No case $SLURM_ARRAY_TASK_ID in $CASES"; exit 1; fi

if [ ! -f "$H5" ]; then echo "Input file not found: $H5"; exit 1; fi
echo "[run] case $SLURM_ARRAY_TASK_ID: $SIM -> $H5"
echo "[run] $SLURM_NTASKS MPI tasks x $SLURM_CPUS_PER_TASK cpus"

module purge
source /opt/cray/pe/cpe/25.09/restore_lmod_system_defaults.sh
module load PrgEnv-nvidia
module load craype-accel-nvidia80
module load cudatoolkit
module load cray-hdf5-parallel

export MPICH_GPU_SUPPORT_ENABLED=1
export ACC_DEVICE_TYPE=nvidia
export HDF5_USE_FILE_LOCKING=FALSE
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

set -eo pipefail
srun -n "$SLURM_NTASKS" -c "$SLURM_CPUS_PER_TASK" --cpu-bind=cores --gpu-bind=single:1 \
     /global/homes/m/mpatel26/ascot5/ascot5_develop_mp_hpc_GPU/build/ascot5_main --in="$H5"
echo "[run] done: $SIM"
