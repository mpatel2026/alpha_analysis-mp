#!/bin/bash
#SBATCH --job-name=Eos10-DDN-fastparticle-prep_run
#SBATCH --output=/global/u2/m/mpatel26/alpha_analysis-mp/campaigns/Eos10-DDN-fastparticle/logs/prep_run_%A_%a.out
#SBATCH --account=m4477
#SBATCH --constraint=gpu
#SBATCH --qos=shared
#SBATCH --gpus=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --time=01:30:00
#SBATCH --mail-type=begin,end,fail
#SBATCH --mail-user=mpatel26@thea.energy
# Generated by campaign.py from campaigns/Eos10-DDN-fastparticle.json -- edit the manifest, not this file.

CASES="/global/u2/m/mpatel26/alpha_analysis-mp/campaigns/Eos10-DDN-fastparticle/cases.tsv"
IFS=$'\t' read -r SIM H5 PARAMS MARKER < <(sed -n "${SLURM_ARRAY_TASK_ID}p" "$CASES")
if [ -z "$SIM" ]; then echo "No case $SLURM_ARRAY_TASK_ID in $CASES"; exit 1; fi

echo "[prep] case $SLURM_ARRAY_TASK_ID: $SIM -> $H5"
module purge
module load conda
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate ascot-develop-mp

set -eo pipefail
cd /global/u2/m/mpatel26/alpha_analysis-mp
SRUN="srun -n 1 -c $SLURM_CPUS_PER_TASK --cpu-bind=cores"
$SRUN python -u create-input.py --params="$PARAMS"
$SRUN python -u set_field_and_profiles.py --params="$PARAMS"
echo "[prep] done: $SIM"

set +eo pipefail
conda deactivate

if [ ! -f "$H5" ]; then echo "Input file not found: $H5"; exit 1; fi
echo "[run] case $SLURM_ARRAY_TASK_ID: $SIM -> $H5"
echo "[run] $SLURM_NTASKS MPI tasks x $SLURM_CPUS_PER_TASK cpus"

module purge
source /opt/cray/pe/cpe/25.09/restore_lmod_system_defaults.sh
module load PrgEnv-nvidia
module load craype-accel-nvidia80
module load cudatoolkit
module load cray-hdf5-parallel

export MPICH_GPU_SUPPORT_ENABLED=1
export ACC_DEVICE_TYPE=nvidia
export HDF5_USE_FILE_LOCKING=FALSE
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

set -eo pipefail
srun -n "$SLURM_NTASKS" -c "$SLURM_CPUS_PER_TASK" --cpu-bind=cores --gpu-bind=single:1 \
     /global/homes/m/mpatel26/ascot5/ascot5_develop_mp_hpc_GPU/build/ascot5_main --in="$H5"
echo "[run] done: $SIM"
