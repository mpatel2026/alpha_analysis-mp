#!/bin/bash
#SBATCH --job-name=create_inputs
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --output=prep-logs/slurm-%j.out
#SBATCH --cpus-per-task=64
#SBATCH --time=02:00:00
#SBATCH --constraint=gpu&hbm80g
#SBATCH --gpus-per-node=4
#SBATCH --qos=regular
#SBATCH --account=m4477
#SBATCH --mail-type=begin,end,fail
#SBATCH --mail-user=mpatel26@thea.energy

# Device (CPU/GPU) and JAX/XLA environment are configured automatically at
# runtime by device_setup.py, imported first thing by each script below.

# 1. Environment Setup
module purge
module load conda


source $(conda info --base)/etc/profile.d/conda.sh
conda activate ascot-develop-mp


PARAMS="alphaprep-params/ISHW-paper/G1600-10e6-markers-GC-engwall-decay-FOrestart.json"
MARKERS="beam-markers/G1600-LCFSwall-lost-FO-1M-randomgyrophase.json"

srun -n 1 -c 64 --cpu-bind=cores python -u create-input.py --params=$PARAMS

srun -n 1 -c 64 --cpu-bind=cores python -u set_mrk.py --params=$PARAMS --marker_file=$MARKERS
#srun -n 1 -c 64 --cpu-bind=cores python -u set_field_and_profiles.py --params=$PARAMS


