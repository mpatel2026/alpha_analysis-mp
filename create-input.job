#!/bin/bash
#SBATCH --job-name=create_inputs
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --output=prep-logs/slurm-%j.out
#SBATCH --cpus-per-task=64
#SBATCH --time=00:05:00
#SBATCH --constraint=gpu
#SBATCH --gpus-per-node=1
#SBATCH --qos=debug
#SBATCH --account=m4477
#SBATCH --mail-type=begin,end,fail
#SBATCH --mail-user=mpatel26@thea.energy

# Device (CPU/GPU) and JAX/XLA environment are configured automatically at
# runtime by device_setup.py, imported first thing by each script below.

# 1. Environment Setup
module purge
module load conda


source $(conda info --base)/etc/profile.d/conda.sh
conda activate ascot-develop-mp


PARAMS="alphaprep-params/beams/EosOP3LowDensity2p0x_P12MWbroader.json"
MARKERS="beam-markers/markers_EosOP3LowDensity2p0x_P12MWbroader.json"

srun -n 1 -c 64 --cpu-bind=cores python -u create-input.py --params=$PARAMS

srun -n 1 -c 64 --cpu-bind=cores python -u set_mrk_gc.py --params=$PARAMS --marker_file=$MARKERS
#srun -n 1 -c 64 --cpu-bind=cores python -u set_field_and_profiles.py --params=$PARAMS


